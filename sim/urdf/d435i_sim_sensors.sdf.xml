<!--
  Simulated Intel RealSense D435i sensors, in native SDF form, injected
  directly into spot_gazebo_ros2's spot_description/models/spot/model.sdf.

  This is the SDF-native counterpart to d435i_sim.urdf.xacro: the URDF/xacro
  overlay only feeds robot_state_publisher's *TF-only* view (it does nothing
  for Gazebo, which spawns the robot straight from model.sdf), so the actual
  camera+IMU <sensor> elements have to live here to ever produce data.

  Frame hierarchy mirrors d435i_sim.urdf.xacro exactly (fixed joints, all
  poses given absolute/relative-to-model like the rest of model.sdf):
    base_link
      -> camera_link                    (0.30 0 0.12, mount point)
           -> camera_infra1_frame       (physical; carries the infra1 sensor)
                -> camera_infra1_optical_frame   (REP103 -> optical rotation)
           -> camera_infra2_frame       (50mm baseline; carries infra2 sensor)
                -> camera_infra2_optical_frame
           -> camera_depth_optical_frame        (carries the depth sensor;
                                                   co-located with infra1)
           -> camera_imu_optical_frame          (carries the IMU; no optical
                                                   rotation, matches D435i's
                                                   own IMU axis convention)

  Topics/gz_frame_id match gz_bridge.yaml exactly (camera/infra1/..., etc.)
  so no bridge config changes are needed once this is actually loaded.
-->
<link name="camera_link">
  <pose>0.30 0 0.12 0 0 0</pose>
  <inertial>
    <mass>1e-05</mass>
    <inertia>
      <ixx>0.001</ixx><ixy>1e-06</ixy><ixz>1e-06</ixz>
      <iyy>0.001</iyy><iyz>1e-06</iyz><izz>0.001</izz>
    </inertia>
  </inertial>
</link>
<joint name="camera_link_j" type="fixed">
  <child>camera_link</child>
  <parent>base_link</parent>
  <axis>
    <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
    <xyz>0 0 1</xyz>
    <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
  </axis>
  <physics><ode><limit><cfm>0</cfm><erp>0.2</erp></limit></ode></physics>
</joint>

<link name="camera_infra1_frame">
  <pose>0.30 0 0.12 0 0 0</pose>
  <inertial>
    <mass>1e-05</mass>
    <inertia>
      <ixx>0.001</ixx><ixy>1e-06</ixy><ixz>1e-06</ixz>
      <iyy>0.001</iyy><iyz>1e-06</iyz><izz>0.001</izz>
    </inertia>
  </inertial>
  <sensor name="infra1" type="camera">
    <always_on>1</always_on>
    <update_rate>30</update_rate>
    <visualize>true</visualize>
    <topic>camera/infra1/image_rect_raw</topic>
    <gz_frame_id>camera_infra1_optical_frame</gz_frame_id>
    <camera>
      <horizontal_fov>1.5708</horizontal_fov>
      <image><width>640</width><height>360</height><format>L8</format></image>
      <clip><near>0.1</near><far>50</far></clip>
      <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
    </camera>
  </sensor>
</link>
<joint name="camera_infra1_frame_j" type="fixed">
  <child>camera_infra1_frame</child>
  <parent>camera_link</parent>
  <axis>
    <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
    <xyz>0 0 1</xyz>
    <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
  </axis>
  <physics><ode><limit><cfm>0</cfm><erp>0.2</erp></limit></ode></physics>
</joint>

<link name="camera_infra1_optical_frame">
  <pose>0.30 0 0.12 -1.570796 0 -1.570796</pose>
  <inertial>
    <mass>1e-05</mass>
    <inertia>
      <ixx>0.001</ixx><ixy>1e-06</ixy><ixz>1e-06</ixz>
      <iyy>0.001</iyy><iyz>1e-06</iyz><izz>0.001</izz>
    </inertia>
  </inertial>
</link>
<joint name="camera_infra1_optical_frame_j" type="fixed">
  <child>camera_infra1_optical_frame</child>
  <parent>camera_infra1_frame</parent>
  <axis>
    <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
    <xyz>0 0 1</xyz>
    <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
  </axis>
  <physics><ode><limit><cfm>0</cfm><erp>0.2</erp></limit></ode></physics>
</joint>

<link name="camera_infra2_frame">
  <pose>0.30 -0.05 0.12 0 0 0</pose>
  <inertial>
    <mass>1e-05</mass>
    <inertia>
      <ixx>0.001</ixx><ixy>1e-06</ixy><ixz>1e-06</ixz>
      <iyy>0.001</iyy><iyz>1e-06</iyz><izz>0.001</izz>
    </inertia>
  </inertial>
  <sensor name="infra2" type="camera">
    <always_on>1</always_on>
    <update_rate>30</update_rate>
    <visualize>true</visualize>
    <topic>camera/infra2/image_rect_raw</topic>
    <gz_frame_id>camera_infra2_optical_frame</gz_frame_id>
    <camera>
      <horizontal_fov>1.5708</horizontal_fov>
      <image><width>640</width><height>360</height><format>L8</format></image>
      <clip><near>0.1</near><far>50</far></clip>
      <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
    </camera>
  </sensor>
</link>
<joint name="camera_infra2_frame_j" type="fixed">
  <child>camera_infra2_frame</child>
  <parent>camera_link</parent>
  <axis>
    <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
    <xyz>0 0 1</xyz>
    <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
  </axis>
  <physics><ode><limit><cfm>0</cfm><erp>0.2</erp></limit></ode></physics>
</joint>

<link name="camera_infra2_optical_frame">
  <pose>0.30 -0.05 0.12 -1.570796 0 -1.570796</pose>
  <inertial>
    <mass>1e-05</mass>
    <inertia>
      <ixx>0.001</ixx><ixy>1e-06</ixy><ixz>1e-06</ixz>
      <iyy>0.001</iyy><iyz>1e-06</iyz><izz>0.001</izz>
    </inertia>
  </inertial>
</link>
<joint name="camera_infra2_optical_frame_j" type="fixed">
  <child>camera_infra2_optical_frame</child>
  <parent>camera_infra2_frame</parent>
  <axis>
    <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
    <xyz>0 0 1</xyz>
    <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
  </axis>
  <physics><ode><limit><cfm>0</cfm><erp>0.2</erp></limit></ode></physics>
</joint>

<link name="camera_depth_optical_frame">
  <pose>0.30 0 0.12 -1.570796 0 -1.570796</pose>
  <inertial>
    <mass>1e-05</mass>
    <inertia>
      <ixx>0.001</ixx><ixy>1e-06</ixy><ixz>1e-06</ixz>
      <iyy>0.001</iyy><iyz>1e-06</iyz><izz>0.001</izz>
    </inertia>
  </inertial>
  <sensor name="depth" type="depth_camera">
    <always_on>1</always_on>
    <update_rate>15</update_rate>
    <visualize>true</visualize>
    <topic>camera/depth</topic>
    <gz_frame_id>camera_depth_optical_frame</gz_frame_id>
    <camera>
      <horizontal_fov>1.5184</horizontal_fov>
      <image><width>640</width><height>360</height><format>R_FLOAT32</format></image>
      <clip><near>0.28</near><far>10</far></clip>
    </camera>
  </sensor>
</link>
<joint name="camera_depth_optical_frame_j" type="fixed">
  <child>camera_depth_optical_frame</child>
  <parent>camera_link</parent>
  <axis>
    <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
    <xyz>0 0 1</xyz>
    <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
  </axis>
  <physics><ode><limit><cfm>0</cfm><erp>0.2</erp></limit></ode></physics>
</joint>

<link name="camera_imu_optical_frame">
  <pose>0.30 0 0.12 0 0 0</pose>
  <inertial>
    <mass>1e-05</mass>
    <inertia>
      <ixx>0.001</ixx><ixy>1e-06</ixy><ixz>1e-06</ixz>
      <iyy>0.001</iyy><iyz>1e-06</iyz><izz>0.001</izz>
    </inertia>
  </inertial>
  <sensor name="d435i_imu" type="imu">
    <always_on>1</always_on>
    <update_rate>200</update_rate>
    <topic>camera/imu</topic>
    <gz_frame_id>camera_imu_optical_frame</gz_frame_id>
    <imu>
      <angular_velocity>
        <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
        <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
        <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
      </angular_velocity>
      <linear_acceleration>
        <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
        <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
        <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
      </linear_acceleration>
    </imu>
  </sensor>
</link>
<joint name="camera_imu_optical_frame_j" type="fixed">
  <child>camera_imu_optical_frame</child>
  <parent>camera_link</parent>
  <axis>
    <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
    <xyz>0 0 1</xyz>
    <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
  </axis>
  <physics><ode><limit><cfm>0</cfm><erp>0.2</erp></limit></ode></physics>
</joint>
