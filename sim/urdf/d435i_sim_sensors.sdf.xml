</joint>

<!-- RGB color sensor, matching the real D435i's color stream. Same pattern
     as infra1/infra2: sensor sits on a level physical frame, the -90/-90
     optical-convention rotation only applies to a separate, sensor-less
     child frame used for TF/frame_id labeling. -->
<link name="camera_color_frame">
  <pose>0.30 0 0.12 0 0 0</pose>
  <inertial>
    <mass>1e-05</mass>
    <inertia>
      <ixx>0.001</ixx><ixy>1e-06</ixy><ixz>1e-06</ixz>
      <iyy>0.001</iyy><iyz>1e-06</iyz><izz>0.001</izz>
    </inertia>
  </inertial>
  <sensor name="color" type="camera">
    <always_on>1</always_on>
    <update_rate>15</update_rate>
    <visualize>true</visualize>
    <topic>camera/color/image_raw</topic>
    <gz_frame_id>camera_color_optical_frame</gz_frame_id>
    <camera>
      <horizontal_fov>1.211</horizontal_fov>
      <image><width>640</width><height>480</height><format>R8G8B8</format></image>
      <clip><near>0.1</near><far>50</far></clip>
      <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
    </camera>
  </sensor>
</link>
<joint name="camera_color_frame_j" type="fixed">
  <child>camera_color_frame</child>
  <parent>camera_link</parent>
  <axis>
    <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
    <xyz>0 0 1</xyz>
    <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
  </axis>
  <physics><ode><limit><cfm>0</cfm><erp>0.2</erp></limit></ode></physics>
</joint>

<link name="camera_color_optical_frame">
  <pose>0.30 0 0.12 -1.570796 0 -1.570796</pose>
