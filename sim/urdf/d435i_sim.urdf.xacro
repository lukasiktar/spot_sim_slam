<?xml version="1.0"?>
<!--
  Simulated Intel RealSense D435i for Gazebo Sim, matching the real driver's
  frame names and topic layout so the identical VSLAM configuration works in
  sim and on the robot.

  Provides:
    - stereo IR pair (grayscale, 50 mm baseline, 640x360 @ 30 Hz)
    - depth camera + point cloud
    - IMU @ 200 Hz
  Frames: camera_link, camera_infra{1,2}_frame, camera_infra{1,2}_optical_frame,
          camera_imu_optical_frame, camera_depth_optical_frame

  Usage (injected automatically by scripts/inject_camera.py):
    <xacro:include filename="d435i_sim.urdf.xacro"/>
    <xacro:d435i_sim parent="base_link" xyz="0.30 0 0.12" rpy="0 0 0"/>
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="d435i_sim" params="parent xyz:='0.30 0 0.12' rpy:='0 0 0'">

    <!-- ============ links & joints ============ -->
    <link name="camera_link">
      <inertial>
        <mass value="0.072"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
      <visual>
        <geometry><box size="0.025 0.090 0.025"/></geometry>
        <material name="d435_grey"><color rgba="0.3 0.3 0.3 1"/></material>
      </visual>
      <collision>
        <geometry><box size="0.025 0.090 0.025"/></geometry>
      </collision>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="camera_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- left IR: on the real D435i infra1 sits at the depth origin -->
    <link name="camera_infra1_frame"/>
    <joint name="camera_infra1_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_infra1_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="camera_infra1_optical_frame"/>
    <joint name="camera_infra1_optical_joint" type="fixed">
      <parent link="camera_infra1_frame"/>
      <child link="camera_infra1_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- right IR: 50 mm baseline -->
    <link name="camera_infra2_frame"/>
    <joint name="camera_infra2_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_infra2_frame"/>
      <origin xyz="0 -0.050 0" rpy="0 0 0"/>
    </joint>
    <link name="camera_infra2_optical_frame"/>
    <joint name="camera_infra2_optical_joint" type="fixed">
      <parent link="camera_infra2_frame"/>
      <child link="camera_infra2_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="camera_depth_optical_frame"/>
    <joint name="camera_depth_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_depth_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="camera_imu_optical_frame"/>
    <joint name="camera_imu_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_imu_optical_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- ============ Gazebo Sim sensors ============ -->
    <gazebo reference="camera_infra1_frame">
      <sensor name="infra1" type="camera">
        <update_rate>30</update_rate>
        <topic>camera/infra1/image_rect_raw</topic>
        <gz_frame_id>camera_infra1_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>640</width><height>360</height>
            <format>L8</format>
          </image>
          <clip><near>0.1</near><far>50</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
        </camera>
        <always_on>1</always_on>
      </sensor>
    </gazebo>

    <gazebo reference="camera_infra2_frame">
      <sensor name="infra2" type="camera">
        <update_rate>30</update_rate>
        <topic>camera/infra2/image_rect_raw</topic>
        <gz_frame_id>camera_infra2_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>640</width><height>360</height>
            <format>L8</format>
          </image>
          <clip><near>0.1</near><far>50</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
        </camera>
        <always_on>1</always_on>
      </sensor>
    </gazebo>

    <gazebo reference="camera_depth_optical_frame">
      <sensor name="depth" type="depth_camera">
        <update_rate>15</update_rate>
        <topic>camera/depth</topic>
        <gz_frame_id>camera_depth_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>640</width><height>360</height>
            <format>R_FLOAT32</format>
          </image>
          <clip><near>0.28</near><far>10</far></clip>
        </camera>
        <always_on>1</always_on>
      </sensor>
    </gazebo>

    <gazebo reference="camera_imu_optical_frame">
      <sensor name="d435i_imu" type="imu">
        <update_rate>200</update_rate>
        <topic>camera/imu</topic>
        <gz_frame_id>camera_imu_optical_frame</gz_frame_id>
        <always_on>1</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
