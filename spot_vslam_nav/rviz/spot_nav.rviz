Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      # Upstream's own robot_state_publisher is fed raw SDF (spot.gazebo.launch.py
      # reads model.sdf directly into the "robot_description" parameter, not a
      # URDF) so it can drive TF correctly, but SDF's <pose> composition rules
      # differ from URDF's <origin> rules -- RViz's RobotModel display parses
      # URDF only, and pointing it at that SDF topic silently misinterprets the
      # per-link poses, producing a mesh that is rigidly offset from the real
      # TF-correct robot (this is what previously looked like "the robot is
      # ~1m below the map": there was no correct mesh here, only whatever a
      # manually-added display parsing the wrong source produced). Use the
      # genuine URDF (same links/joints, already includes the injected D435i)
      # that ships alongside it instead -- File mode needs no extra node and
      # its meshes resolve via package://spot_description exactly as installed
      # in this same image.
      Description Source: File
      Description File: /ws/install/spot_description/share/spot_description/models/spot/model.urdf
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/Odometry
      Name: VSLAM Odometry
      Topic:
        Value: /visual_slam/tracking/odometry
      Enabled: true
      Keep: 200
    - Class: rviz_default_plugins/PointCloud2
      Name: VSLAM Landmarks
      Topic:
        Value: /visual_slam/vis/landmarks_cloud
      Enabled: true
      Size (m): 0.03
    - Class: rviz_default_plugins/LaserScan
      Name: Depth Scan
      Topic:
        Value: /scan
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Topic:
        Value: /global_costmap/costmap
      Color Scheme: costmap
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Topic:
        Value: /local_costmap/costmap
      Color Scheme: costmap
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Topic:
        Value: /plan
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Topic:
        Value: /local_plan
      Enabled: true
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Pitch: 0.8
      Yaw: 0.0
      # Follow the robot rather than orbiting the Fixed Frame's (map) origin.
      # cuVSLAM's map/odom convention starts near (0,0,0) regardless of
      # where the robot actually spawns in the world -- in this sim, Spot
      # spawns ~80m from that origin, so without a Target Frame the default
      # view shows empty space near (0,0,0) with the robot completely
      # outside the initial viewport, looking like everything is "offset".
      Target Frame: base_link
Window Geometry:
  Height: 900
  Width: 1400
