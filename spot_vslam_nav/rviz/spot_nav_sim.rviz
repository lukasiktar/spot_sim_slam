Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Global Options:
    # Sim-only variant of spot_nav.rviz: Fixed Frame is "odom", not "map".
    #
    # In this sim, nvblox/Nav2 plan in "odom" because it's Gazebo's own
    # ground-truth pose (see odom_rerooter.py) -- stable, unlike this
    # tunnel's repeating tiles, which alias cuVSLAM's stereo tracking badly
    # enough that its map->odom correction jumps around, including in z.
    # Rendering through "map" (as spot_nav.rviz does, correctly, for the
    # real robot) makes the ENTIRE scene -- robot model, costmaps, all of
    # it -- visibly bob with every one of those jumps, even though the
    # underlying odom-frame data driving navigation is fine. "odom" here
    # is the stable ground truth, so anchoring the view to it removes that
    # rendering artifact. Do not apply this same swap on the real robot:
    # there it's real kinematic odom that drifts and "map" that's correct
    # -- spot_nav.rviz's "map" Fixed Frame is the right choice there.
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      # Upstream's own robot_state_publisher is fed raw SDF (spot.gazebo.launch.py
      # reads model.sdf directly into the "robot_description" parameter, not a
      # URDF) so it can drive TF correctly, but SDF's <pose> composition rules
      # differ from URDF's <origin> rules -- RViz's RobotModel display parses
      # URDF only, and pointing it at that SDF topic silently misinterprets the
      # per-link poses, producing a mesh that is rigidly offset from the real
      # TF-correct robot (this is what previously looked like "the robot is
      # ~1m below the map": there was no correct mesh here, only whatever a
      # manually-added display parsing the wrong source produced). Use the
      # genuine URDF (same links/joints, already includes the injected D435i)
      # that ships alongside it instead -- File mode needs no extra node and
      # its meshes resolve via package://spot_description exactly as installed
      # in this same image.
      Description Source: File
      Description File: /ws/install/spot_description/share/spot_description/models/spot/model.urdf
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/Odometry
      Name: VSLAM Odometry
      Topic:
        Value: /visual_slam/tracking/odometry
      Enabled: false
      # Off by default here: this is cuVSLAM's own tracked pose, which is
      # exactly the estimate that's aliasing on the tunnel's repeating
      # tiles. With the view anchored to "odom" (ground truth) instead of
      # "map", this trail will visibly diverge from the robot model over
      # time -- that's cuVSLAM's real tracking error made visible, not a
      # rendering bug. Enable it if you specifically want to see how badly
      # cuVSLAM is drifting; leave off for a clean view of the robot itself.
      Keep: 20
    - Class: rviz_default_plugins/PointCloud2
      Name: VSLAM Landmarks
      Topic:
        Value: /visual_slam/vis/landmarks_cloud
      Enabled: true
      Size (m): 0.03
    - Class: rviz_default_plugins/LaserScan
      Name: Depth Scan
      Topic:
        Value: /scan
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Topic:
        Value: /global_costmap/costmap
      Color Scheme: costmap
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Topic:
        Value: /local_costmap/costmap
      Color Scheme: costmap
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: nvblox 2D Map
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Color Scheme: map
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: nvblox ESDF
      Topic:
        Value: /nvblox_node/static_esdf_pointcloud
      Style: Boxes
      Size (m): 0.08
      Enabled: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Person Pins
      Topic:
        Value: /found_persons/markers
        Durability Policy: Transient Local
      Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Frontiers
      Topic:
        Value: /search/frontiers
      Enabled: true
    - Class: rviz_default_plugins/Image
      Name: Person Detections
      Topic:
        Value: /person_detector/debug_image
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Topic:
        Value: /plan
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Topic:
        Value: /local_plan
      Enabled: true
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Pitch: 0.8
      Yaw: 0.0
      # Follow the robot rather than orbiting the Fixed Frame's origin.
      Target Frame: base_link
Window Geometry:
  Height: 900
  Width: 1400
